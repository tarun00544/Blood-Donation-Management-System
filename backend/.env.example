# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it contains your MySQL password).

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blood_donation_system
DB_PORT=3306

# Flask server
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=true

# Which websites may call this API. "*" = anyone (fine for a college project).
# Example for a specific frontend: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# A blood group is "low stock" when its valid units are below this number
LOW_STOCK_THRESHOLD=10
EXPIRING_SOON_DAYS=7
